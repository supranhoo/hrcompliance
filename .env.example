# Names only. Never commit values. Copy to .env.local (git-ignored) for development.
# --- Browser-exposed (publishable key is safe by design: RLS + grants enforce access) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=development
# --- Server-side ONLY (Edge Function secrets / CI secret store). Never VITE_-prefixed, never in the browser, never in chat. ---
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GMAIL_SENDER_ADDRESS=
